# ============================================================
# Model + backend config — mirrors the HuggingFaceEmbedding(...) call
# ============================================================

MODEL_NAME=onnx-community/embeddinggemma-300m-ONNX
EMBED_BATCH_SIZE=8
MAX_LENGTH=512

# "cpu" for Railway (no GPU support there today). Set to "cuda" only if you
# deploy this elsewhere on a GPU-enabled host.
DEVICE=cpu

ONNX_FILE_NAME=model_quantized.onnx
ONNX_SUBFOLDER=onnx
# CPUExecutionProvider on Railway; CUDAExecutionProvider if DEVICE=cuda on a
# GPU host (and you've swapped onnxruntime -> onnxruntime-gpu in requirements.txt)
ONNX_PROVIDER=CPUExecutionProvider

# Caps ONNX Runtime's thread pools -- kept low by default to favor a small
# memory footprint over max throughput on small Railway instances.
ORT_INTRA_OP_THREADS=1
ORT_INTER_OP_THREADS=1

# Prefix prepended to queries, distinguishing them from indexed documents.
# Clients can override it per request with the "instruction" field on
# POST /embed/query (send "" there to embed with no prefix at all).
QUERY_INSTRUCTION=task: search result | query:
# For Qwen3-Embedding instead, the query prefix encodes the task and
# documents get no prefix at all:
# QUERY_INSTRUCTION=Instruct: Given a web search query, retrieve relevant passages that answer the query\nQuery:

# Optional: a separate instruction prefix applied when embedding documents
# (leave unset to use the model's default behavior)
# TEXT_INSTRUCTION=title: none | text:

# ============================================================
# Reranker config (used by POST /rerank)
# ============================================================
RERANKER_MODEL_NAME=onnx-community/Qwen3-Reranker-0.6B-ONNX
RERANKER_ONNX_FILE_NAME=model_quantized.onnx
RERANKER_ONNX_SUBFOLDER=onnx
# Qwen3-Reranker is a 0.6B decoder run once per (query, document) pair with no
# KV-cache reuse, so RAM and latency scale with max_length x batch_size. Its
# full context window is 8192, but keep this at 1024-2048 unless you actually
# rerank long documents.
RERANKER_MAX_LENGTH=2048
# Kept low by default -- batch_size x max_length long sequences add up fast
# in memory on small Railway instances.
RERANKER_BATCH_SIZE=4
# Task description baked into Qwen3-Reranker's judging prompt. Clients can
# override it per request with the "instruction" field on POST /rerank.
# Ignored by cross-encoder rerankers (bge-reranker-v2-m3), which have no
# such prompt.
RERANKER_INSTRUCTION=Given a web search query, retrieve relevant passages that answer the query

# Swap back to the cross-encoder reranker instead (lighter per request, but no
# instruction following):
# RERANKER_MODEL_NAME=onnx-community/bge-reranker-v2-m3-ONNX
# RERANKER_MAX_LENGTH=8192

# Optional: point the Hugging Face cache at a mounted Railway volume so the
# model isn't re-downloaded on every deploy/restart (see README "Persisting
# the model across deploys").
HF_HOME=/model/hf-cache

# Railway sets PORT automatically in production; only needed for local runs
PORT=8000
