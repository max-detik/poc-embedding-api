# ============================================================
# Backend
# ============================================================
# Leave DEVICE/DTYPE unset to auto-detect: CUDA + float16 when a GPU is
# present, CPU + float32 otherwise. Set them to pin the choice.
# DEVICE=cuda
# DTYPE=float16          # float16 (Ampere+), bfloat16, or float32

# Encode batch size. 64 suits a GPU; drop to 8-16 on CPU.
EMBED_BATCH_SIZE=64

# ============================================================
# Model: microsoft/harrier-oss-v1-0.6b (1024d)
# ============================================================
# Harrier supports 32k context; the default 1024 trades that for throughput.
# Raise it if you index long documents.
# EMBED_MAX_SEQ_LENGTH=2048

# Matryoshka truncation: shorter vectors, smaller index, slightly less
# accuracy. Leave unset to keep all 1024 dimensions.
# EMBED_TRUNCATE_DIM=512

# Task description in the query instruction. Clients can override it per
# request with the "task" field on POST /embed/query.
# EMBED_TASK=Given a web search query, retrieve relevant passages that answer the query

# Optional: harrier is ungated, but a token raises Hub rate limits.
# HF_TOKEN=hf_...

# ============================================================
# Runtime
# ============================================================
# Optional: point the Hugging Face cache at persistent storage so weights
# aren't re-downloaded on every deploy/restart.
# HF_HOME=/data/hf-cache

# Only needed for local runs; most platforms set PORT themselves.
PORT=8000
